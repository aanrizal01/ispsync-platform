# ─────────────────────────────────────────────────────────────────
# ISP Billing Platform — Environment Configuration
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────
ENV=development
APP_NAME=ISP Billing Platform
APP_BASE_URL=http://localhost:8080

# ── Server ────────────────────────────────────────────────────────
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# ── Database ──────────────────────────────────────────────────────
# Format: postgres://user:password@host:port/dbname?sslmode=disable
DATABASE_URL=postgres://postgres:postgres_dev_password@localhost:5432/isp_billing?sslmode=disable
POSTGRES_PASSWORD=postgres_dev_password
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFE=5m

# ── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://:redis_dev_password@localhost:6379/0
REDIS_PASSWORD=redis_dev_password
REDIS_DB=0

# ── JWT (RS256) ───────────────────────────────────────────────────
# Generate keys with: make generate-keys (or scripts/generate-keys.sh)
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=168h

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000

# ── Logging ───────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_FORMAT=console

# ── Rate Limiting ─────────────────────────────────────────────────
RATE_LIMIT_RPM=100
RATE_LIMIT_AUTH_RPM=1000

# ── Migrations ────────────────────────────────────────────────────
MIGRATIONS_PATH=migrations

# ── FreeRADIUS ────────────────────────────────────────────────────
RADIUS_SECRET=change_this_to_long_random_secret_in_production

# ── Payment Gateways ──────────────────────────────────────────────
# Midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_ENV=sandbox

# Xendit
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

# Duitku
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
DUITKU_ENV=sandbox

# ── Notifications ─────────────────────────────────────────────────
# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@isp.example.com

# WhatsApp Business API
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=

# ── ACS & FTTH Integration (GenieACS TR-069) ──────────────────────
# Point this to your existing FTTH GenieACS server (e.g. http://192.168.1.50:7557)
# or localhost if using local Docker container.
GENIEACS_NBI_URL=http://localhost:7557
GENIEACS_CWMP_URL=http://acs.isp.local:7547/
GENIEACS_UI_URL=http://localhost:7558

# ── Next.js ───────────────────────────────────────────────────────
NEXTAUTH_SECRET=change_this_nextauth_secret_in_production
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
