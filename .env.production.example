# ==============================================================================
# ISP Billing & Network Access Management Platform
# Production Environment Configuration Template
#
# INSTRUCTIONS:
# 1. Copy this file to .env.production:
#    cp .env.production.example .env.production
# 2. Replace all placeholder values marked with CHANGEME
# 3. Ensure keys/private.pem and keys/public.pem exist (2048-bit RS256)
# ==============================================================================

# ── General ───────────────────────────────────────────────────────────────────
ENV=production
APP_NAME="GigaBill ISP"
DOMAIN=billing.yourisp.net
PORT=3000

# ── Database (PostgreSQL 16) ─────────────────────────────────────────────────
POSTGRES_DB=isp_billing
POSTGRES_USER=isp_admin
POSTGRES_PASSWORD=CHANGEME_STRONG_POSTGRES_PASSWORD_HERE

# ── Redis 7 Cache & Rate Limiting ────────────────────────────────────────────
REDIS_PASSWORD=CHANGEME_STRONG_REDIS_PASSWORD_HERE

# ── FreeRADIUS AAA Secret ─────────────────────────────────────────────────────
RADIUS_SECRET=CHANGEME_STRONG_RADIUS_SHARED_SECRET

# ── NextAuth Frontend Secret ──────────────────────────────────────────────────
NEXTAUTH_SECRET=CHANGEME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# ── Payment Gateways (Optional / Production) ──────────────────────────────────
# Midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_ENV=production

# Xendit
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

# ── Notifications Engine (Multi-Channel) ─────────────────────────────────────
# Telegram Bot API (Token from @BotFather)
TELEGRAM_BOT_TOKEN=

# WhatsApp Gateway (Fonnte)
FONNTE_TOKEN=

# Email SMTP
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@yourisp.net
SMTP_PASS=CHANGEME_SMTP_PASSWORD
SMTP_FROM="GigaBill Billing <billing@yourisp.net>"
