{
    email admin@ispsync.id
    on_demand_tls {
        ask http://172.18.0.1:8081/api/v1/caddy/ask
    }
}

# Main SaaS Landing & Platform App
ispsync.id, www.ispsync.id {
    log {
        output file /var/log/caddy/access.log {
            roll_size 50mb
            roll_keep 10
            roll_keep_for 720h
        }
        format json
    }

    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }

    @no_cache {
        path / /login /index.html
    }
    header @no_cache {
        -Cache-Control
        Cache-Control "no-cache, no-store, must-revalidate"
        Pragma "no-cache"
    }

    handle /api/v1/* {
        reverse_proxy api:8080 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle /health {
        reverse_proxy api:8080
    }

    handle /ready {
        reverse_proxy api:8080
    }

    handle /api/v1/passpoint/credentials/*/apple-profile {
        reverse_proxy api:8080 {
            header_down Content-Type "application/x-apple-aspen-config"
        }
    }

    handle {
        reverse_proxy web:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_down Cache-Control "no-cache, no-store, must-revalidate"
        }
    }
}

# Multi-Tenant Subdomains (On-Demand TLS for *.ispsync.id and *.*.ispsync.id)
https:// {
    tls {
        on_demand
    }
    encode zstd gzip

    header {
        X-Content-Type-Options "nosniff"
        Content-Security-Policy "frame-ancestors 'self' https://*.ispsync.id https://*.*.ispsync.id https:"
        -Server
    }

    @no_cache_sub {
        path / /login
    }
    header @no_cache_sub {
        -Cache-Control
        Cache-Control "no-cache, no-store, must-revalidate"
        Pragma "no-cache"
    }

    # 0. Block legacy cms.* subdomain
    @legacy_cms {
        header_regexp Host ^cms\.
    }
    handle @legacy_cms {
        respond "Subdomain 'cms' sudah diganti! Gunakan billing.*, portal.*, atau fttx.* sesuai arsitektur 3 Engine ISPSYNC." 403 {
            close
        }
    }

    # 0.5. Member Portal routes on tenant domains (e.g. dev.ispsync.id/member)
    @member_portal {
        path /member* /api/member*
    }
    handle @member_portal {
        reverse_proxy web:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_down Cache-Control "no-cache, no-store, must-revalidate"
        }
    }

    # 0.7. Universal Agent & Sales Backoffice (/agent)
    @agent_path {
        path /agent*
    }
    handle @agent_path {
        reverse_proxy web:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_down Cache-Control "no-cache, no-store, must-revalidate"
        }
    }

    # 0.75. Universal Tenant Favicon Handler
    @tenant_favicon {
        path /favicon.ico /favicon.ico*
    }
    handle @tenant_favicon {
        rewrite * /web/{labels.2}_favicon.svg
        reverse_proxy 172.18.0.1:8081 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }

    # 0.8. Universal Static Assets & Tenant Brand Favicons (/web/*)
    @web_assets {
        path /web/*
    }
    handle @web_assets {
        reverse_proxy 172.18.0.1:8081 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }

    # 0.72. Passpoint & HS2.0 Onboarding Portal (/passpoint)
    @passpoint_path {
        path /passpoint*
    }
    handle @passpoint_path {
        reverse_proxy web:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_down Cache-Control "no-cache, no-store, must-revalidate"
        }
    }

    # 0.73. Passpoint Apple MobileConfig Profile Generator (.mobileconfig)
    @passpoint_apple_profile {
        path /api/v1/passpoint/credentials/*/apple-profile
    }
    handle @passpoint_apple_profile {
        reverse_proxy api:8080 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_down Content-Type "application/x-apple-aspen-config"
        }
    }

    # 0.74. Hotspot & Voucher Purchase (/hotspot/*, /buy*)
    @hotspot_path {
        path /hotspot* /buy*
    }
    handle @hotspot_path {
        reverse_proxy web:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_down Cache-Control "no-cache, no-store, must-revalidate"
        }
    }

    # 0.9. Master Engine Showcase Subdomains (Pure technical presentation, no CTA)
    @engine_showcase {
        header_regexp Host ^(ledger|billing|nexus|portal|fibergrid|fttx)\.ispsync\.id$
    }
    handle @engine_showcase {
        reverse_proxy web:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-Host {host}
            header_down Cache-Control "no-cache, no-store, must-revalidate"
        }
    }

    # 1. CMS & Billing Backoffice App (Next.js & API)
    @billing_api {
        header_regexp Host (^(ledger|billing|passpoint|wifi|hotspot)\.|\.(ledger|billing|passpoint|wifi|hotspot)\.)
        path /api/v1/* /health /ready
    }
    handle @billing_api {
        reverse_proxy api:8080 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }

    # Redirect root to /hotspot/buy on WiFi & Hotspot public portal
    @wifi_root {
        header_regexp Host (^(wifi|hotspot)\.|\.(wifi|hotspot)\.)
        path /
    }
    redir @wifi_root /hotspot/buy temporary

    # Redirect root to /login on CMS & Billing backoffice (for tenant domains)
    @billing_root {
        header_regexp Host (^(ledger|billing)\.|\.(ledger|billing)\.)
        not header_regexp Host ^(ledger|billing)\.ispsync\.id$
        path /
    }
    redir @billing_root /login temporary

    # Redirect root to /passpoint on Passpoint subdomain
    @passpoint_root {
        header_regexp Host (^(passpoint)\.|\.(passpoint)\.)
        path /
    }
    redir @passpoint_root /passpoint temporary

    @billing {
        header_regexp Host (^(ledger|billing|passpoint|wifi|hotspot)\.|\.(ledger|billing|passpoint|wifi|hotspot)\.)
    }
    handle @billing {
        reverse_proxy web:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_down Cache-Control "no-cache, no-store, must-revalidate"
        }
    }

    # 2. FTTX & FiberGrid Core Engine (fttx.*, fibergrid.*, noc-fo.*)
    @fttx {
        header_regexp Host (^(fttx|fibergrid|noc-fo)\.|\.(fttx|fibergrid|noc-fo)\.)
        not header_regexp Host ^(fttx|fibergrid)\.ispsync\.id$
    }
    handle @fttx {
        reverse_proxy 172.18.0.1:8082 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_down -X-Frame-Options
            header_down Content-Security-Policy "frame-ancestors 'self' https://*.ispsync.id https://*.*.ispsync.id https:"
        }
    }

    # 3. Customer & Field Operational Portals - ISPSYNC Nexus (nexus.*, portal.*, sales.*, teknisi.*, rekan.*, noc.*, carrier.*)
    @nexus {
        header_regexp Host (^(nexus|portal|sales|teknisi|rekan|noc|carrier)\.|\.(nexus|portal|sales|teknisi|rekan|noc|carrier)\.)
        not header_regexp Host ^(nexus|portal)\.ispsync\.id$
    }
    handle @nexus {
        header {
            -X-Frame-Options
            Content-Security-Policy "frame-ancestors 'self' https://*.ispsync.id https://*.*.ispsync.id https:"
        }
        reverse_proxy 172.18.0.1:8081 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }

    # 4. Fallback handler -> ISPSYNC Core (Port 8081)
    handle {
        reverse_proxy 172.18.0.1:8081 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }
}

# HTTP Fallback
http:// {
    handle /api/* {
        reverse_proxy 172.18.0.1:8081 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
    handle {
        redir https://{host}{uri} permanent
    }
}
